# MahaPulse API runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# PostgreSQL persistence (use a secret DATABASE_URL outside local development)
DATABASE_URL=postgresql+psycopg://mahapulse:change-me@localhost:5432/mahapulse

# Model configuration; replace the classifier value with the fine-tuned MuRIL checkpoint.
MURIL_MODEL_NAME=google/muril-base-cased
KEYBERT_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
BERTopic_LANGUAGE=multilingual
MODEL_DEVICE=cpu

# API configuration
MAX_TEXT_LENGTH=100000
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000
LOW_CONFIDENCE_THRESHOLD=0.60

# Operational limits
RESULT_RETENTION_DAYS=365
